# Copy this file to .env.local and fill in your deployed
# Google Apps Script web app URL for the Property Tax Counter system.
NEXT_PUBLIC_PROPERTY_TAX_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Kill switch for the citizen-facing "Pay Property Tax" online gateway
# on the public property-tax search page. Mirrors the backend's
# ONLINE_PAYMENT_ENABLED - keep both in sync. Defaults to unset/false
# (disabled).
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=false