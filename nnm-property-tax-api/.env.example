# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://nnm_app:changeme@localhost:5432/nnm_property_tax
PGPOOL_MAX=10

# CORS — comma-separated list of allowed origins (your Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Auth — generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Online payment gateway (ICICI)
FRONTEND_URL=http://localhost:3000
ICICI_MERCHANT_ID=100000000445282

# --- Used only by scripts/migrate-from-sheets.ts ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json